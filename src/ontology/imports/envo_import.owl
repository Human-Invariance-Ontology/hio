TransitiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002427>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002473> (composed primarily of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002473> "x composed_primarily_of y if and only if more than half of the mass of x is made from y or units of the same type as y.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002473> "composed primarily of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/BFO_0000051>)
