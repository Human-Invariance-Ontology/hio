ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0002479> <http://purl.obolibrary.org/obo/BFO_0000004>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002494> (transformation of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002494> "x transformation of y if x is the immediate transformation of y, or is linked to y through a chain of transformation relationships")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002494> "transformation of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002494> <http://purl.obolibrary.org/obo/RO_0002202>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002494>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002495> (immediate transformation of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002495> "x immediate transformation of y iff x immediately succeeds y temporally at a time boundary t, and all of the matter present in x at t is present in y at t, and all the matter in y at t is present in x at t")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002495> "immediate transformation of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002495> <http://purl.obolibrary.org/obo/RO_0002207>)
