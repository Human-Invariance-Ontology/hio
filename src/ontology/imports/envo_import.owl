AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000000> "A material entity that consists of two or more organisms, viruses, or viroids."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000000> "collection of organisms"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PCO_0000000> <http://purl.obolibrary.org/obo/BFO_0000040>)
