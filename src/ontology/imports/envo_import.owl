AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PCO_0000031> "A material entity that is one or more organisms, viruses or viroids.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PCO_0000031> "organismal entity"@en)

